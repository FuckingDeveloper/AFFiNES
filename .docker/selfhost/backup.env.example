# Directory where scheduled backups are stored.
TRACKWORK_BACKUP_DIR=./backups

# Delete local backups older than this number of days.
TRACKWORK_BACKUP_RETENTION_DAYS=14

# Optional AES-256 encryption password. Keep the real value outside Git.
TRACKWORK_BACKUP_ENCRYPTION_KEY=

# Optional destination supported by AWS CLI, for example s3://bucket/trackwork.
TRACKWORK_BACKUP_S3_URI=
