# locally built TrackWork image
TRACKWORK_IMAGE=trackwork-local:dev

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links
# AFFINE_SERVER_HTTPS=true
# AFFINE_SERVER_HOST=webtrack.example.com
# or 
# AFFINE_SERVER_EXTERNAL_URL=https://webtrack.example.com

# position of the database data to persist
DB_DATA_LOCATION=~/.trackwork/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=~/.trackwork/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=~/.trackwork/self-host/config

# database credentials
DB_USERNAME=affine
DB_PASSWORD=change-this-to-a-long-random-password
DB_DATABASE=affine
