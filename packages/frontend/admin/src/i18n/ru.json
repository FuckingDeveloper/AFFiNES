  "fields": {
    "server.externalUrl": {
      "desc": "Базовый URL сервера MRH ManSys, используется для генерации внешних ссылок.",
      "example": "https://affine.example.com"
    },
    "server.name": {
      "desc": "Узнаваемое имя сервера. Отображается при подключении через MRH ManSys Desktop.",
      "example": "Сервер моей компании"
    },
    "server.hosts": {
      "desc": "Несколько хостов, с которых сервер будет принимать запросы.",
      "example": "[\"affine.example.com\", \"app.example.com\"]"
    },
    "auth.allowSignup": {
      "desc": "Разрешить ли регистрацию новых пользователей.",
      "example": "true"
    },
    "auth.allowSignupForOauth": {
      "desc": "Разрешить ли регистрацию через настроенные OAuth-провайдеры.",
      "example": "true"
    },
    "auth.mode": {
      "desc": "Активный метод аутентификации. Только один метод может быть активен одновременно.",
      "example": "password"
    },
    "auth.enterprise.autoRegister": {
      "desc": "Автоматически создавать пользователей, прошедших корпоративную аутентификацию.",
