    "auth.enterprise.ldap.bindDN": {
      "desc": "Bind DN сервисной учётной записи LDAP для поиска пользователей.",
      "example": "cn=admin,dc=company,dc=com"
    },
    "auth.enterprise.ldap.bindCredentials": {
      "desc": "Пароль сервисной учётной записи LDAP.",
      "example": "ваш-ldap-пароль"
