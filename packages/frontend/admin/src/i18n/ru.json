    "mailer.SMTP.password": {
      "desc": "Пароль для аутентификации на почтовом сервере.",
      "example": "ваш-email-пароль"
    },
    "mailer.fallbackSMTP.password": {
      "desc": "Пароль для резервного SMTP-сервера.",
